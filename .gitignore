# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenv (uv lays it down at .venv/)
.venv/

# Build artifacts
build/
dist/
*.egg-info/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# IDEs
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

